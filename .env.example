# ════════════════════════════════════════════════════════
#  CDAVP — Environment Configuration Template
#  Copy this file to .env and fill in real values.
#  NEVER commit the actual .env file to version control.
# ════════════════════════════════════════════════════════

# ── Security ─────────────────────────────────────────────
# SECURITY WARNING: Generate a unique 50-character random key for production.
# Use: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-this-to-a-unique-50-char-random-string-in-production

# Set to False in production — NEVER run DEBUG=True on a live server.
# With DEBUG=True, Django shows full tracebacks to any visitor on errors.
DEBUG=True

# Comma-separated list of allowed hostnames. Use * only for local dev.
# Production example: ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
ALLOWED_HOSTS=127.0.0.1,localhost

# ── Database ─────────────────────────────────────────────
# Leave empty to use default SQLite (development only).
# For production, provide a PostgreSQL connection string:
# DATABASE_URL=postgres://user:password@localhost:5432/cdavp_db
DATABASE_URL=

# ── Email (OTP Verification) ──────────────────────────────
# Leave DJANGO_EMAIL_BACKEND as console for local dev (OTPs printed to terminal).
# For production SMTP, switch to:  django.core.mail.backends.smtp.EmailBackend
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-app-password-here
DEFAULT_FROM_EMAIL=CDAVP Portal <no-reply@cdavp.gov.in>

# ── Server ────────────────────────────────────────────────
PORT=8000
